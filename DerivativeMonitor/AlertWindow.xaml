<Window x:Class="DerivativeMonitor.AlertWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DerivativeMonitor"
      Width="350"
        Height="300"
        WindowStartupLocation="CenterScreen"
        Topmost="True" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            ItemsSource="{Binding Alerts}">

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Border
                Margin="0,0,0,10"
                Padding="15"
                BorderThickness="1"
                CornerRadius="8">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- HEADER -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock
                            Text="⚠ MOVIMENTO DETECTADO"
                            FontSize="13"
                            FontWeight="Bold"/>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="10,0,0,0"
                                    Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}"/>
                                

                            </Grid>


                            <!-- TICKER -->
                            <TextBlock
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="{Binding Ticker}"/>


                            <!-- VALUES -->
                            <Grid Grid.Row="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- VALUE -->
                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                Text="Valor"
                                HorizontalAlignment="Center"/>

                                    <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Text="{Binding Value, StringFormat={}{0:N2}}"/>

                                </StackPanel>


                                <!-- AVERAGE -->
                                <StackPanel Grid.Column="1">

                                    <TextBlock
                                Text="Média ativo"
                                HorizontalAlignment="Center"/>

                                    <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Text="{Binding Average, StringFormat={}{0:N2}}"/>

                                </StackPanel>


                                <!-- Z-SCORE -->
                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                Text="Z-Score"
                                HorizontalAlignment="Center"/>

                                    <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Text="{Binding ZScore, StringFormat={}{0:F2}}"/>

                                </StackPanel>

                            </Grid>


                            <!-- MESSAGE -->
                            <Border
                        Grid.Row="3"
                        Margin="0,15,0,0"
                        Padding="8">

                                <TextBlock
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            TextAlignment="Center">
                                    <Run
                                        Text="Período: "
                                        FontWeight="Bold"/>
                                    <Run
                                        Text="{Binding Message}"/>
                                </TextBlock>

                            </Border>

                        </Grid>

                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Button
            Grid.Row="1"
            Content="Limpar Alerta"
            Click="ClearAlertQueue"
            Margin="0,10,0,0"
            Height="40"/>
    </Grid>
</Window>
